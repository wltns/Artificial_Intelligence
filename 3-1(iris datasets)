# --- [실습 3-1 (a), (b)] 붓꽃 데이터 불러오기 및 확인 --- 
from sklearn import datasets  # 기계 학습 라이브러리인 sklearn에서 데이터셋 도구 상자를 불러옴

d = datasets.load_iris()      # 내장된 붓꽃(iris) 데이터를 불러와서 변수 d에 통째로 저장
print(d.DESCR)                # 이 데이터가 어떤 데이터인지 상세 설명서(Description)를 출력

# 순서대로 출력 (데이터 개수만큼 반복문 실행)
for i in range(0, len(d.data)):
    # 인덱스 번호, 샘플의 4가지 특징값(꽃받침/꽃잎의 길이/너비), 그리고 정답 레이블 출력
    print(i+1, d.data[i], d.target[i])


# --- [실습 3-1 (c)] SVM 모델로 붓꽃 품종 예측하기 --- 
from sklearn import svm       # 기계 학습 모델 중 하나인 SVM(서포트 벡터 머신) 도구 호출

# 1. 모델 설정
s = svm.SVC(gamma=0.1, C=10)  # 분류 모델 SVC 생성. (gamma: 영향 범위, C: 오분류 처벌 강도 설정)

# 2. 모델 학습
s.fit(d.data, d.target)       # 훈련용 문제(d.data)와 정답지(d.target)를 주고 모델을 공부시킴

# 3. 새로운 데이터 준비
# 우리가 길가다 주운 새로운 붓꽃 2개의 특징이라고 가정 (데이터 형태는 4차원 배열)
new_d = [[6.4, 3.2, 6.0, 2.5], [7.1, 3.1, 4.7, 1.35]]

# 4. 정답 예측
res = s.predict(new_d)        # 공부를 마친 모델(s)에게 새로운 붓꽃(new_d)이 무슨 품종인지 물어봄
print("새로운 2개 샘플의 부류는", res) # 예측 결과 출력

. (마침표): "~안에 있는" 또는 "~의"
어떤 도구 상자(모듈)나 물건(객체) 내부에 속한 기능이나 데이터를 꺼내 쓸 때 사용합니다.

datasets.load_iris(): "datasets라는 도구 상자 안에 있는 load_iris 기능을 꺼내와라"라는 뜻입니다.

d.DESCR: "d라는 변수(데이터 묶음) 의 DESCR(설명서) 값을 보여달라는 뜻입니다.

_ (밑줄, 언더스코어): 이름 지을 때 띄어쓰기 대신 사용
파이썬에서는 함수나 변수 이름을 지을 때 빈칸(띄어쓰기)을 쓸 수 없습니다. 만약 load iris라고 쓰면 컴퓨터가 두 개의 다른 단어로 착각해서 에러가 납니다.

그래서 단어와 단어 사이를 이어주면서 사람이 읽기 편하게 만들려고 load_iris처럼 띄어쓰기 대신 밑줄을 씁니다. 프로그래밍에서는 이를 뱀처럼 길게 이어진다고 해서 '스네이크 케이스(Snake Case)'라고 부릅니다.

() (괄호): "이 기능을 지금 실행해!" (동작 버튼)
함수(어떤 동작을 수행하는 코드)를 실행할 때 반드시 붙여야 하는 '시작 버튼' 같은 존재입니다.

load_iris(): 괄호가 붙었기 때문에 "iris 데이터를 불러오는 작업을 지금 당장 실행해라"라는 명령이 됩니다. 만약 괄호를 빼고 load_iris라고만 쓰면 기계는 작동하지 않습니다.

print(d.DESCR): 기능에 따라 괄호 안에 재료를 넣어주기도 합니다. "d.DESCR이라는 재료를 괄호 안에 넣어줄 테니, 이걸 화면에 출력(print)해라"라는 뜻이 됩니다.
