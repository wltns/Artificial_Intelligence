import random
import os
seed = 42
random.seed(seed)
np.random.seed(seed)
os.environ["PYTHONHASHSEED"] = str(seed)
import warnings
import numpy as np
import pandas as pd
from sklearn.svm import SVC
from sklearn.linear_model import Perceptron
from sklearn.neural_network import MLPClassifier
from sklearn.metrics import accuracy_score

# 데이터 로드
train_df = pd.read_csv('/kaggle/input/competitions/2026-2-ai-w-3-p-2-digits/train.csv')
test_df = pd.read_csv('/kaggle/input/competitions/2026-2-ai-w-3-p-2-digits/test.csv')
sample_sub = pd.read_csv('/kaggle/input/competitions/2026-2-ai-w-3-p-2-digits/sample_submission.csv')

# 특성/ 라벨 분리 
X_train = train_df.drop(columns=['label'])
y_train = train_df['label']
X_test = test_df.copy()

# 모델 정의 
models = {
    'SVC': SVC(random_state=seed),
    'Perceptron': Perceptron(random_state=seed),
    'MLPClassifier': MLPClassifier(random_state=seed)
}

# 모델 학습 / 훈련 데이터 평가
for name, model in models.items():
    model.fit(X_train, y_train)
    train_acc = accuracy_score(y_train, model.predict(X_train))
    print(f"{name:15s} Train Accuracy: {train_acc:.4f}")

# 최종 제출 파일 생성 
best_model = models['SVC']
sample_sub['label'] = best_model.predict(X_test)
sample_sub.to_csv('submission.csv', index=False)
