from sklearn import datasets 
from sklearn.model_selection import train_test_split, cross_val_score
import numpy as np

# 교수님이 요구하신 4가지 모델 불러오기
from sklearn import svm                  # 1. SVM
from sklearn.neighbors import KNeighborsClassifier # 2. K-NN
from sklearn.tree import DecisionTreeClassifier    # 3. 결정 나무
from sklearn.ensemble import RandomForestClassifier # 4. 랜덤 포레스트

# 난수 고정 (결과가 매번 바뀌지 않도록 교수님 지시사항 적용)
np.random.seed(0)

# 숫자 데이터 불러오기
digit = datasets.load_digits()

# 훈련 집합(60%)과 테스트 집합(40%)으로 데이터 분할
# train_size=0.6 옵션으로 6:4 비율을 맞춥니다.
x_train, x_test, y_train, y_test = train_test_split(digit.data, digit.target, train_size=0.6)

# 평가할 4가지 모델을 리스트로 준비 
models = [
    svm.SVC(gamma=0.001),
    KNeighborsClassifier(),
    DecisionTreeClassifier(random_state=0),
    RandomForestClassifier(random_state=0)
]

for model in models:
    accuracies = cross_val_score(model, x_train, y_train, cv=5)
    
    # model 변수 자체를 출력
    print(f"{model} 정확률(평균): {accuracies.mean()*100:.2f}%")
