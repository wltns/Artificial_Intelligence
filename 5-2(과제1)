시드 고정 → csv 읽어서 텐서로 → DataLoader → 모델/옵티마이저/손실 → 학습 반복 → 예측 → csv 저장

# 라이브러리+시드 고정
import random
import os
import numpy as np
import pandas as pd
import torch

seed = 42
random.seed(seed)
np.random.seed(seed)
os.environ["PYTHONHASHSEED"] = str(seed)
torch.manual_seed(seed)
torch.cuda.manual_seed(seed)
torch.cuda.manual_seed_all(seed)
torch.backends.cudnn.deterministic = True
torch.backends.cudnn.benchmark = False
torch.use_deterministic_algorithms(False)

from torch.utils.data import TensorDataset, DataLoader

train = pd.read_csv("train.csv")   
test = pd.read_csv("test.csv")

train_X = train.iloc[:, :-1]   # 마지막 열 빼고 전부 = 픽셀 784개
train_Y = train.iloc[:, -1]    # 마지막 열 = 라벨
test_X = test

train_X = torch.FloatTensor(np.array(train_X))
train_Y = torch.LongTensor(np.array(train_Y))
test_X = torch.FloatTensor(np.array(test_X))

train_dataset = TensorDataset(train_X, train_Y)
test_dataset = TensorDataset(test_X)

train_loader = DataLoader(train_dataset, batch_size=128, shuffle=True)
test_loader = DataLoader(test_dataset, batch_size=128, shuffle=False)

class MLP(torch.nn.Module):
    def __init__(self, input_dim, hidden_dim, output_dim):
        super().__init__()
        self.model = torch.nn.Sequential(
            torch.nn.Linear(input_dim, hidden_dim),
            torch.nn.ReLU(),
            torch.nn.Linear(hidden_dim, hidden_dim),
            torch.nn.ReLU(),
            torch.nn.Linear(hidden_dim, output_dim)  # softmax 붙이지 않기
        )

    def forward(self, x):
        return self.model(x)

model = MLP(784, 512, 10).cuda()
optimizer = torch.optim.Adam(model.parameters(), lr=0.001)
loss_fn = torch.nn.CrossEntropyLoss()

import tqdm

for epoch in tqdm.tqdm(range(20)):
    model.train()
    total_loss = 0
    correct = 0
    for X, y in train_loader:
        X = X.cuda()
        y = y.cuda()

        pred = model(X)
        cost = loss_fn(pred, y)

        optimizer.zero_grad()
        cost.backward()
        optimizer.step()

        total_loss += cost.item()
        correct += torch.sum(torch.argmax(pred, dim=1) == y).item()

    print(f"epoch {epoch+1} | loss {total_loss:.2f} | acc {correct/len(train_dataset):.4f}")

model.eval()
preds = []
with torch.no_grad():
    for (X,) in test_loader:      # TensorDataset(test_X)는 요소가 1개짜리 튜플이라 (X,)로 받음
        X = X.cuda()
        pred = model(X)
        preds.extend(torch.argmax(pred, dim=1).cpu().numpy())

submission = pd.read_csv("sample_submission.csv")  # 경로 수정
submission["label"] = preds
submission.to_csv("submission.csv", index=False)
